{
  "name": "aust-odl-backend",
  "version": "1.1.0",
  "description": "AUST ODL Admission System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:push": "npx prisma db push",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "npx prisma studio",
    "setup": "npx prisma db push && node prisma/seed.js",
    "prisma:seed:lms": "node prisma/seedLmsAcademic.js",
    "prisma:seed:university": "node prisma/seedUniversityDataset.js",
    "prisma:seed:demo": "node prisma/seedDemoAccounts.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.18.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
